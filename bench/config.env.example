# Template for bench/config.env (create config.env with real values; it is
# gitignored). Placeholders only — never put real addresses here.

SSH3_BIN="/usr/local/bin/ssh3"
# Example: -insecure (self-signed server cert) + key file
SSH3_ARGS="-insecure -privkey /home/user/.ssh/id_ed25519"

RUNS=10
HANDSHAKE_RUNS=30
RTT_ITERS=100
PAUSE_S=2
SIZE_MB=512
REMOTE_DIR="/dev/shm/ssh3-bench"
SSH2_CIPHER="aes128-gcm@openssh.com"

# Stands: ssh2 = user@host + port; ssh3 = user@host:port/url-path
S1_SSH2_DEST="user@192.0.2.10"
S1_SSH2_PORT="22"
S1_SSH3_TARGET="user@192.0.2.10:443/ssh3-term"

S2_SSH2_DEST="user@192.0.2.20"
S2_SSH2_PORT="22"
S2_SSH3_TARGET="user@192.0.2.20:443/ssh3-term"

# Optional: server process discovery for CPU sampling (B6)
# CPU_PIDCMD_SSH3="systemctl show -p MainPID --value ssh3-server"
# CPU_PIDCMD_SSH2="pgrep -n -x sshd"
