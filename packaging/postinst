#!/bin/sh
set -e

case "$1" in
  configure|1)
    if [ ! -s /etc/ssh3/cert.pem ] || [ ! -s /etc/ssh3/priv.key ]; then
      rm -f /etc/ssh3/cert.pem /etc/ssh3/priv.key
      # clients validate the cert against the address they dial: SANs are
      # mandatory, otherwise the QUIC handshake fails IP-SAN verification
      HOST_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
      SAN="DNS:$(hostname -s),DNS:$(hostname)"
      [ -n "$HOST_IP" ] && SAN="IP:$HOST_IP,$SAN"
      openssl req -x509 -newkey ed25519 -nodes -days 3650 \
        -subj "/CN=$(hostname -s)" \
        -addext "subjectAltName=$SAN" \
        -keyout /etc/ssh3/priv.key -out /etc/ssh3/cert.pem >/dev/null 2>&1
      chmod 600 /etc/ssh3/priv.key
      chmod 644 /etc/ssh3/cert.pem
    fi
    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload >/dev/null 2>&1 || true
      systemctl enable ssh3-server.service >/dev/null 2>&1 || true
      systemctl restart ssh3-server.service >/dev/null 2>&1 || true
    fi
    ;;
esac
exit 0
