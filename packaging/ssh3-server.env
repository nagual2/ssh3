# ssh3-server: systemd EnvironmentFile (instance configuration).
# Authentication: public keys only (~/.ssh/authorized_keys or
# ~/.ssh3/authorized_identities of the target user). Password auth is
# compiled out (build tag disable_password_auth), no OIDC configured.
SSH3_LOG_FILE=/var/log/ssh3.log
SSH3_LOG_LEVEL=info
# locale forwarded by the server to user shells
LANG=C.UTF-8
